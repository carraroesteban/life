# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels > tu túnel > Docker)
TUNNEL_TOKEN=

# Tu usuario de administrador. Se crea solo la primera vez que arranca la app.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Mail de contacto para las notificaciones push (lo piden los navegadores, nadie lo ve)
PUSH_CONTACT=mailto:tu@mail.com
